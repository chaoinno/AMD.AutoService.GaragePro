{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/AMD.AutoService.GaragePro.API"
      ],
      "port": 5080,
      "url": "http://localhost:5080"
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--port",
        "5173",
        "--strictPort"
      ],
      "cwd": "web",
      "port": 5173
    }
  ]
}
