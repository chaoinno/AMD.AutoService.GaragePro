# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
WORKDIR /app

RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY web/ ./
ARG VITE_API_BASE_URL=https://gpservice-api.garage-pro.net
ARG VITE_LEGACY_ASSET_BASE_URL=https://media.garage-pro.net/
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_LEGACY_ASSET_BASE_URL=$VITE_LEGACY_ASSET_BASE_URL
RUN pnpm build

FROM nginx:1.28-alpine AS runtime
COPY --from=deployment web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
