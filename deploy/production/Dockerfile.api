# syntax=docker/dockerfile:1.7
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY AMD.AutoService.GaragePro.sln ./
COPY backend/AMD.AutoService.GaragePro.Domain/*.csproj backend/AMD.AutoService.GaragePro.Domain/
COPY backend/AMD.AutoService.GaragePro.Application/*.csproj backend/AMD.AutoService.GaragePro.Application/
COPY backend/AMD.AutoService.GaragePro.Infrastructure/*.csproj backend/AMD.AutoService.GaragePro.Infrastructure/
COPY backend/AMD.AutoService.GaragePro.API/*.csproj backend/AMD.AutoService.GaragePro.API/
COPY tools/spadmin/*.csproj tools/spadmin/
RUN dotnet restore backend/AMD.AutoService.GaragePro.API/AMD.AutoService.GaragePro.API.csproj \
 && dotnet restore tools/spadmin/SpAdmin.csproj

COPY backend/ backend/
COPY tools/spadmin/ tools/spadmin/
RUN dotnet publish backend/AMD.AutoService.GaragePro.API/AMD.AutoService.GaragePro.API.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore \
 && rm -f /app/publish/appsettings.Development.json

# spadmin — เครื่องมือทีมงานของอู่ทดลองใช้ (tools/spadmin/README.md) อยู่ใน image เดียวกับ API ที่ /app/spadmin
# รันด้วย env file ของ API (docker compose run --rm --no-deps --entrypoint dotnet api /app/spadmin/SpAdmin.dll list)
# — ไม่มีไฟล์ค่าตั้ง/ความลับเพิ่ม · ไม่ใช่ entrypoint ของ container (API ยังเป็นโปรเซสเดียวที่รันเอง)
RUN dotnet publish tools/spadmin/SpAdmin.csproj \
    --configuration Release \
    --output /app/spadmin \
    --no-restore \
 && rm -f /app/spadmin/appsettings.Development.json

# Bundle EF migrations into the runtime image. Deployment runs these executables
# as one-off jobs before replacing the API container.
#  - efbundle            : ServiceDbContext (svc_*) — GarageService, and GarageSelfServe via env override
#  - efbundle-selfserve  : SelfServeDbContext (sp_*, history table __EFMigrationsHistory_SelfServe)
# Both contexts have IDesignTimeDbContextFactory implementations (Infrastructure/SelfServe/DesignTimeFactories.cs)
# that read the connection string from the environment at run time, so building the bundles no longer needs
# a placeholder Jwt__Key or connection string (EF logs that the API host could not start and uses the factory).
RUN dotnet tool install --tool-path /tools dotnet-ef --version 8.0.11 \
 && /tools/dotnet-ef migrations bundle \
    --project backend/AMD.AutoService.GaragePro.Infrastructure/AMD.AutoService.GaragePro.Infrastructure.csproj \
    --startup-project backend/AMD.AutoService.GaragePro.API/AMD.AutoService.GaragePro.API.csproj \
    --context ServiceDbContext \
    --configuration Release \
    --output /app/efbundle \
    --force \
 && /tools/dotnet-ef migrations bundle \
    --project backend/AMD.AutoService.GaragePro.Infrastructure/AMD.AutoService.GaragePro.Infrastructure.csproj \
    --startup-project backend/AMD.AutoService.GaragePro.API/AMD.AutoService.GaragePro.API.csproj \
    --context SelfServeDbContext \
    --configuration Release \
    --output /app/efbundle-selfserve \
    --force

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && addgroup --system appgroup \
 && adduser --system --ingroup appgroup appuser \
 && mkdir -p /app/storage \
 && chown -R appuser:appgroup /app

COPY --from=build --chown=appuser:appgroup /app/publish ./
COPY --from=build --chown=appuser:appgroup /app/efbundle ./efbundle
COPY --from=build --chown=appuser:appgroup /app/efbundle-selfserve ./efbundle-selfserve
COPY --from=build --chown=appuser:appgroup /app/spadmin ./spadmin

USER appuser
EXPOSE 8080

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_BUNDLE_EXTRACT_BASE_DIR=/tmp/.net

HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=5 \
    CMD curl --fail --silent --show-error http://127.0.0.1:8080/health >/dev/null || exit 1

ENTRYPOINT ["dotnet", "AMD.AutoService.GaragePro.API.dll"]
