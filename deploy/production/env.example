# Copy to /home/deployment/config/garagepro-service.env and chmod 600.
# Do not commit the real file. scripts/bootstrap-production-secrets.sh can
# create it from this Mac's dotnet user-secrets and the existing Admin FTP config.
ConnectionStrings__ServiceDb=Server=...;Database=GarageService;User Id=...;Password=...;TrustServerCertificate=True
LegacyShards__ConnectionStrings__db1=Server=...;Database=Garage;User Id=...;Password=...;TrustServerCertificate=True
LegacyShards__ConnectionStrings__db2=Server=...;Database=Garage;User Id=...;Password=...;TrustServerCertificate=True
Jwt__Key=replace-with-at-least-32-random-characters
Ftp__Host=10.10.3.11
Ftp__Port=21
Ftp__Username=replace-me
Ftp__Password=replace-me
# ฟอร์ม "ขอ Demo" หน้า landing → กลุ่ม LINE (LINE Messaging API push) — ไม่ตั้งแล้วฟอร์มแจ้งให้ติดต่อทาง LINE/โทรแทน
LineMessaging__ChannelAccessToken=replace-me
LineMessaging__ContactGroupId=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# --- Self-serve trial (shard sp1 -> GarageSelfServe) — OPTIONAL ---
# ไม่ใส่/เว้นว่าง = ไม่มี self-serve: API ทำงานแบบเดิม และ deploy ไม่ migrate ฐานนี้
# ต้อง provision ฐานก่อน (deploy/selfserve/provision-selfserve-db.sh) · ทั้งสองบรรทัดแรกเป็นค่าเดียวกัน (login gp_selfserve_app)
# SelfServe__ConnectionString=Server=10.10.4.11;Database=GarageSelfServe;User Id=gp_selfserve_app;Password=...;TrustServerCertificate=True;Encrypt=False
# LegacyShards__ConnectionStrings__sp1=Server=10.10.4.11;Database=GarageSelfServe;User Id=gp_selfserve_app;Password=...;TrustServerCertificate=True;Encrypt=False
# ใช้เฉพาะตอน deploy รัน migration (login gp_selfserve_migrate มีสิทธิ์ DDL) — แอปไม่อ่านคีย์นี้
# SelfServe__MigrationConnectionString=Server=10.10.4.11;Database=GarageSelfServe;User Id=gp_selfserve_migrate;Password=...;TrustServerCertificate=True;Encrypt=False
# --- Self-serve integrations — OPTIONAL (ใส่ผ่าน user-secrets ของ Mac คีย์ Production:SelfServe:* แล้วรัน bootstrap) ---
# Google Sign-In (OAuth client แบบ Web · authorized origin https://service.garage-pro.net) — ไม่ตั้ง = ซ่อนปุ่ม Google
# SelfServe__Google__ClientId=1234567890-xxxx.apps.googleusercontent.com
# Cloudflare Turnstile — site key แสดงบนเว็บได้ · secret key ห้ามเผยแพร่ · Production ที่ไม่มี secret = ปฏิเสธการสมัครทุกคำขอ
# SelfServe__Turnstile__SiteKey=0x4AAAAAAA...
# SelfServe__Turnstile__SecretKey=0x4AAAAAAA...
# ผู้ให้บริการอีเมล: Provider=log (ค่าเริ่มต้น) = Production ปิดสมัครด้วยอีเมล เหลือแต่ Google
# Provider=cloudflare = Cloudflare Email Service (ขั้นตอนตั้งค่าฝั่ง Cloudflare: docs/16-cloudflare-email-setup.md)
# ApiKey = API token สิทธิ์ "Email Sending: Edit" · AccountId = บัญชีที่ onboard โดเมน service.garage-pro.net ไว้ (ผู้ส่งต้องเป็น @service.garage-pro.net)
# ตั้ง cloudflare แต่ขาด AccountId/ApiKey/FromAddress = API ยังสตาร์ทได้ แต่ปิดสมัครด้วยอีเมลและ log error บอกชื่อคีย์ที่ขาด
# SelfServe__Email__Provider=cloudflare
# SelfServe__Email__ApiKey=replace-me
# SelfServe__Email__AccountId=0123456789abcdef0123456789abcdef
# SelfServe__Email__FromAddress=no-reply@service.garage-pro.net
# SelfServe__Email__FromName=ServicePro
# SelfServe__Email__ReplyToAddress=support@garage-pro.net
# กลุ่ม LINE ทีมขาย (สมัครใหม่/ขอต่ออายุ/สรุปรายวัน) — ว่าง = ใช้ LineMessaging__ContactGroupId
# SelfServe__SalesLineGroupId=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
