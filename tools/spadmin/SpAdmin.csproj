<Project Sdk="Microsoft.NET.Sdk">

  <!-- spadmin — เครื่องมือทีมงานของอู่ทดลองใช้ (S5) · ดู README.md
       · FrameworkReference ของ ASP.NET Core ให้ Microsoft.Extensions.Hosting/Logging.Console/Configuration.* มาจาก shared framework
         (image runtime ของ API = aspnet:8.0 มีครบอยู่แล้ว) — ไม่ต้องเพิ่ม NuGet package ใหม่
       · UserSecretsId เดียวกับ API และ tools/devseed: บนเครื่อง dev อ่าน connection string ชุดเดียวกับที่ API ใช้ -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AMD.AutoService.GaragePro.SpAdmin</RootNamespace>
    <AssemblyName>SpAdmin</AssemblyName>
    <UserSecretsId>b844a272-cad9-4f64-af12-483db746d53a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\AMD.AutoService.GaragePro.Infrastructure\AMD.AutoService.GaragePro.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Condition: .dockerignore ตัด appsettings.Development.json ทุกไฟล์ออกจาก build context (กัน secret เข้า image)
         ถ้าอ้างแบบไม่มีเงื่อนไข dotnet publish ใน Dockerfile.api ล้มด้วย MSB3030 -->
    <Content Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
