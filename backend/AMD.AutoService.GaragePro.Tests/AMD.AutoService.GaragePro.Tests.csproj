<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <!-- เทสต์ DI hook ของ self-serve ต้องสร้าง IConfiguration ในหน่วยความจำ (ConfigurationBuilder อยู่ในแพ็กเกจนี้ ไม่ใช่ Abstractions) -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMD.AutoService.GaragePro.Application\AMD.AutoService.GaragePro.Application.csproj" />
    <ProjectReference Include="..\AMD.AutoService.GaragePro.Domain\AMD.AutoService.GaragePro.Domain.csproj" />
    <ProjectReference Include="..\AMD.AutoService.GaragePro.Infrastructure\AMD.AutoService.GaragePro.Infrastructure.csproj" />
    <!-- กติกาล้วนของชั้น API (RateLimiting/RateLimitRules) — ทดสอบโดยไม่ยก host/WebApplicationFactory -->
    <ProjectReference Include="..\AMD.AutoService.GaragePro.API\AMD.AutoService.GaragePro.API.csproj" />
    <!-- ตัว parse คำสั่ง + DI ของ tools/spadmin (S5) -->
    <ProjectReference Include="..\..\tools\spadmin\SpAdmin.csproj" />
  </ItemGroup>

  <!-- [SECURITY] project reference ไป API คัด appsettings.Development.json (มี connection string จริง — CLAUDE.md [RISK])
       มาไว้ใน bin ของเทสต์ด้วย เทสต์ไม่ได้ใช้ไฟล์นี้ — ลบทิ้งไม่ให้ความลับกระจายไปอีกที่ -->
  <Target Name="RemoveApiDevelopmentSettings" AfterTargets="Build">
    <Delete Files="$(OutDir)appsettings.Development.json" />
  </Target>

</Project>
