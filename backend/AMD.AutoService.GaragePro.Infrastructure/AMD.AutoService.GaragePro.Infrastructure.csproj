<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AMD.AutoService.GaragePro.Application\AMD.AutoService.GaragePro.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="FluentFTP" Version="50.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <!-- design-time factory อ่าน appsettings + user-secrets ของ API แบบเดียวกับแอป (dotnet ef database update บนเครื่อง dev) -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- ลายเซ็นจำลองของข้อมูลตัวอย่างอู่ทดลองใช้ (S3 StarterDataRepository) — ระบุไฟล์ตรงๆ ห้ามใช้ glob ทั้งโฟลเดอร์
         (ไฟล์อื่นใน Resources ลงทะเบียนแยกของใครของมัน glob จะฝังซ้ำแล้ว build ล้มด้วย CS1508) -->
    <EmbeddedResource Include="SelfServe\Resources\sample-signature.png"
                      LogicalName="AMD.AutoService.GaragePro.Infrastructure.SelfServe.Resources.sample-signature.png" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
